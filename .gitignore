# macOS
.DS_Store

# Go build artifacts
*.test
*.out
/bin/
# The CLI built in place — `go build ./cmd/kiff` drops a `kiff` binary at the
# repo root. CI builds it into a temp dir, but local builds land here.
/kiff

# Local Go scratch files
/tmp/
/.local/

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Environment files (secrets, local DB urls)
.env
.env.local

# Local Kiro / agent metadata that should not pollute the framework repo
.kiro/

# Test artifacts
coverage.out
coverage.html

# Launch preparation work — kept private until shipped.
# Drafts for HN posts, screencast scripts, X threads, deployment notes,
# day-of runbooks, etc. live here. Nothing in /launch/ is part of the
# framework's public surface.
/launch/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

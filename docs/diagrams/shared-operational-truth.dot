digraph shared_operational_truth {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad="0.25",
    nodesep="0.4",
    ranksep="0.7",
    fontname="Arial"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#A9B9B3",
    fillcolor="#F4F7F5",
    fontcolor="#18352D",
    fontname="Arial",
    fontsize=12,
    margin="0.18,0.12"
  ];
  edge [color="#4D7568", fontcolor="#4D7568", penwidth=1.5, arrowsize=0.7, fontname="Arial", fontsize=10];

  systems [label="Existing systems", fillcolor="#F2ECE2", color="#D4B684"];
  agents [label="Agents", fillcolor="#E4F1E9"];
  humans [label="Humans", fillcolor="#E4F1E9"];
  services [label="Services", fillcolor="#E4F1E9"];
  domain [
    label="KIFF domain\n\nevents  |  state  |  actions\nauthority  |  audit",
    fillcolor="#D9EEE4",
    color="#28755D",
    penwidth=2
  ];
  executor [label="Your executor", fillcolor="#F4F7F5"];

  systems -> domain [label="events"];
  agents -> domain [label="propose actions"];
  humans -> domain [label="propose actions"];
  services -> domain [label="propose actions"];
  domain -> executor [label="valid action"];
  executor -> domain [label="resulting events"];
}

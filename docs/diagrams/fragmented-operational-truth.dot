digraph fragmented_operational_truth {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad="0.25",
    nodesep="0.45",
    ranksep="0.7",
    fontname="Arial"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#A9B9B3",
    fillcolor="#F4F7F5",
    fontcolor="#18352D",
    fontname="Arial",
    fontsize=12,
    margin="0.18,0.12"
  ];
  edge [color="#6D8078", penwidth=1.4, arrowsize=0.7];

  support [label="Support agent", fillcolor="#E4F1E9"];
  finance [label="Finance agent", fillcolor="#E4F1E9"];
  human [label="Human application", fillcolor="#E4F1E9"];

  support_model [label="Its own state, rules,\nand integrations"];
  finance_model [label="Its own state, rules,\nand integrations"];
  human_model [label="Its own state, rules,\nand integrations"];

  systems [label="Business systems", fillcolor="#F2ECE2", color="#D4B684"];

  support -> support_model -> systems;
  finance -> finance_model -> systems;
  human -> human_model -> systems;
}
